# Ollama native runs on the host, not in Docker (no Metal GPU passthrough on macOS).
# From inside the backend container, reach it via host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text

QDRANT_URL=http://localhost:6333

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Which prompts/answer_<version>.txt template to use for grounded generation.
ACTIVE_PROMPT_VERSION=v1
