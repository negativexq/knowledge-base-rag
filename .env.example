# Ollama native runs on the host, not in Docker (no Metal GPU passthrough on macOS).
# From inside the backend container, reach it via host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text

# Sprint 22: production embedding is now selected via EMBEDDING_MODEL_KEY
# + EMBEDDING_OUTPUT_DIMENSION — the single source of truth every other
# embedding attribute (Ollama model name, instruction strings) is looked
# up FROM, via app/llm/embedding_models.py's per-model registry. Do NOT
# just edit these and restart: the physical Qdrant collection for the
# new model must exist and be activated first, or the app will refuse to
# start (app/migration/startup_guard.py). See
# docs/embedding-migration.md for the full migration procedure.
#
# Current production default (post Sprint 18-21 benchmark decision):
# Qwen3-Embedding-4B truncated to 1024 dimensions.
EMBEDDING_MODEL_KEY=qwen3-4b
EMBEDDING_OUTPUT_DIMENSION=1024

# Sprint 26: production reranker decision from the full 220-query benchmark.
# Candidate/output sizes remain the controlled production values (20 -> 5).
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_BACKEND=sentence-transformers
RERANKER_CANDIDATE_K=20
RERANKER_TOP_N=5
# Only set true for a model that explicitly requires custom model code.
RERANKER_TRUST_REMOTE_CODE=false

# The Qdrant alias real traffic is served through once a migration has
# activated at least once. Before any migration has run, this doesn't
# exist yet and every code path falls back to QDRANT_COLLECTION_NAME
# below unchanged — an unmigrated/legacy deployment is unaffected.
QDRANT_ACTIVE_ALIAS=kb_active

# Generation and embedding are independent choices — Claude has no
# embedding endpoint, so EMBEDDING_PROVIDER can never follow
# GENERATION_PROVIDER. See docs/PLANNING.md Sprint 1 closing note.
GENERATION_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
CLAUDE_MAX_TOKENS=2048

QDRANT_URL=http://localhost:6333

# Notion integration token (Internal Integration Secret). Needed for
# NotionConnector and for tests/test_notion_e2e.py's real-API test — that
# test skips automatically if this is unset. See docs/PLANNING.md Sprint 6
# closing note.
NOTION_API_KEY=

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Which prompts/answer_<version>.txt template to use for grounded generation.
ACTIVE_PROMPT_VERSION=v3

# Sprint 25: production/default is strict — buffer, validate, then release.
# FAST is an explicit opt-in for lower-latency development paths only.
# FAST streams before validation; output may reach the client before a
# violation is detected and reported.
SECURITY_VALIDATION_MODE=strict

# DeepEval judge model for app/evaluation (golden-set runs). Independent of
# OLLAMA_MODEL — a golden-set run typically uses a smaller/faster model for
# generation and this one for judging. See docs/PLANNING.md Sprint 9 closing
# note.
EVAL_JUDGE_MODEL=qwen2.5:7b-instruct

# Bounded concurrency for embedding calls during ingestion — chosen from a
# real benchmark against native Ollama, not guessed. See docs/PLANNING.md
# Sprint 14 closing note and the README's throughput section.
EMBEDDING_CONCURRENCY=4

# Sprint 23: security boundary. Defaults to enabled (true) — do NOT set
# this to false outside local development. When false, every request is
# treated as UserContext(user_id="dev-bypass", tenant_id="local-dev",
# roles={ADMIN}) with NO token check at all — app/wiring.py logs a loud
# warning at startup whenever this is off. See docs/security.md.
AUTH_ENABLED=true

# Optional: a raw JSON object REPLACING (not merging with) the demo dev
# token fixture in app/security/auth.py::DEFAULT_DEV_TOKENS. A real
# deployment should set this (or better, replace TokenAuthenticator with
# a real verifier — see docs/security.md's known limitations) rather
# than rely on the demo tokens. Example shape:
#   {"my-real-token": {"user_id": "alice", "tenant_id": "acme", "roles": ["OPERATOR"]}}
AUTH_TOKENS_JSON=

# Sprint 23: which tenant owns documents ingested through each connector
# — server-side configuration, never a value a request/ingest call can
# choose. This app has one connector instance per source_type, so this
# is a direct source_type -> tenant mapping.
FILESYSTEM_TENANT_ID=tenant-a
NOTION_TENANT_ID=tenant-a

# Sprint 24: explicit browser origins for the React Operations Console.
# Keep this an allow-list; never use '*' for authenticated browser traffic.
# Local frontend defaults: http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
