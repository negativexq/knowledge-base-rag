# Ollama native runs on the host, not in Docker (no Metal GPU passthrough on macOS).
# From inside the backend container, reach it via host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# DEV_FAST local generation profile: smaller interactive model and no thinking.
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_THINKING=false
OLLAMA_NUM_CTX=4096
OLLAMA_EMBED_MODEL=nomic-embed-text

# Default portfolio RAG path. Enables evidence-backed construction.
RAG_PIPELINE_V2=true
# Enables request-scoped support units and application-owned support-ID validation.
SUPPORT_IDS_ENABLED=true
# Evidence text budget in Qwen tokenizer tokens (sized for OLLAMA_NUM_CTX=4096).
PIPELINE_V2_CONTEXT_TOKEN_BUDGET=1600
# Optional Phase 6C semantic answerability shadow evaluator. Disabled by
# default; when enabled it records semantic observations but never suppresses
# the existing answer generation path.
SEMANTIC_ANSWERABILITY_ENABLED=false
SEMANTIC_ANSWERABILITY_SHADOW=true
ANSWERABILITY_EVAL_MODEL=qwen3:4b
ANSWERABILITY_EVAL_TIMEOUT_SECONDS=30
ANSWERABILITY_EVAL_RETRIES=1

# Optional answer paths, off by default. Derived answers compute arithmetic
# server-side from operands the model names; the operand resolver fills in
# missing operands from the evidence (needs derived answers). Visual answers
# read ranked page images and need an image-capable provider (openai).
DERIVED_ANSWERS_ENABLED=false
OPERAND_RESOLVER_ENABLED=false
VISUAL_ANSWERS_ENABLED=false

# Critical-value validator rollout. Architecture V2 is the validated
# portfolio-runtime default. baseline and v3 remain explicit server-side
# rollback/debug options. User requests cannot select this value.
CRITICAL_VALIDATOR_VERSION=architecture_v2
CRITICAL_VALIDATOR_V3_SHADOW_ENABLED=false
# Architecture V2 is authoritative through the selector above. Its diagnostic
# shadow remains opt-in and is not enabled by default.
CRITICAL_VALIDATOR_ARCH_V2_SHADOW_ENABLED=false

# Active production embedding configuration. EMBEDDING_MODEL_KEY and
# EMBEDDING_OUTPUT_DIMENSION are the source of truth; every other
# embedding attribute (Ollama model name, instruction strings) is looked
# up FROM, via app/llm/embedding_models.py's per-model registry. Do NOT
# just edit these and restart: the physical Qdrant collection for the
# new model must exist and be activated first, or the app will refuse to
# start (app/migration/startup_guard.py). See
# docs/embedding-migration.md for the full migration procedure.
#
# Current production default:
# Qwen3-Embedding-4B truncated to 1024 dimensions.
EMBEDDING_MODEL_KEY=qwen3-4b
EMBEDDING_OUTPUT_DIMENSION=1024

# Active global/reference reranker configuration. Candidate/output sizes are
# the controlled reference values (20 -> 5). When this variable is omitted,
# DEV_FAST defaults to 15 -> 5 for local iteration; BENCHMARK_REFERENCE uses
# 20 -> 5.
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_BACKEND=sentence-transformers
RERANKER_CANDIDATE_K=20
RERANKER_TOP_N=5
# One local BGE inference at a time protects a shared M2 16 GB model instance.
RERANKER_MAX_CONCURRENCY=1
# Only set true for a model that explicitly requires custom model code.
RERANKER_TRUST_REMOTE_CODE=false

# Active production chunking configuration. The current baseline is the
# legacy whitespace-word window (500/50). When
# CHUNKING_MODE=token_aware, target/overlap/hard-max and the Qwen-compatible
# tokenizer below are the server-owned source of truth; never change only a
# collection name. Candidates use hard_max = target + 64 (pre-committed).
CHUNKING_MODE=baseline
CHUNK_TARGET_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
CHUNK_HARD_MAX_TOKENS=576
CHUNK_TOKENIZER_MODEL=Qwen/Qwen3-Embedding-4B
CHUNK_TOKENIZER_REVISION=main
CHUNK_BOUNDARY_STRATEGY=sentence_heading_page_v1

# The Qdrant alias real traffic is served through once a migration has
# activated at least once. Before any migration has run, this doesn't
# exist yet and every code path falls back to QDRANT_COLLECTION_NAME
# below unchanged — an unmigrated/legacy deployment is unaffected.
QDRANT_ACTIVE_ALIAS=kb_active

# Generation and embedding are independent choices — Claude has no
# embedding endpoint, so EMBEDDING_PROVIDER can never follow
# GENERATION_PROVIDER.
GENERATION_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
# DEV_FAST or BENCHMARK_REFERENCE. Candidate-k experiments override only
# the experiment argument; the reference value remains 20 -> 5.
RUNTIME_PROFILE=DEV_FAST
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
CLAUDE_MAX_TOKENS=2048

QDRANT_URL=http://localhost:6333

# Optional Notion integration token. Leaving this unset disables the
# Notion connector.
NOTION_API_KEY=

# POST /chat input guardrails (docs/security.md "Chat input guardrails").
# Max question length in characters after trimming, and requests per user
# per sliding minute (0 disables the rate limit; in-process, per worker).
CHAT_MAX_QUESTION_CHARS=2000
CHAT_RATE_LIMIT_PER_MINUTE=30
# Rule-based prompt-injection and PII screening of chat questions and
# answers: "shadow" records findings on spans and in the audit log without
# blocking anything; "off" disables it.
CONTENT_SCREENING_MODE=shadow

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Optional: also export query/LLM traces to a self-hosted Langfuse (OTLP
# HTTP). Deactivated by default. To use it: `make langfuse-up` (heavy, see
# docker-compose.langfuse.yml), then set LANGFUSE_ENABLED=true. The keys
# below match that stack's headless-init project. Spans carry metadata only
# (model, timings, counts), never prompt or answer text; sync/ingestion
# spans stay in Jaeger.
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=pk-lf-kb-rag-local
LANGFUSE_SECRET_KEY=sk-lf-kb-rag-local

# Which prompts/answer_<version>.txt template to use for grounded generation.
ACTIVE_PROMPT_VERSION=v3

# Production/default is strict — buffer, validate, then release.
# FAST is an explicit opt-in for lower-latency development paths only.
# FAST streams before validation; output may reach the client before a
# violation is detected and reported.
SECURITY_VALIDATION_MODE=strict

# DeepEval judge model for evaluation (golden-set runs). Independent of
# OLLAMA_MODEL — a golden-set run typically uses a smaller/faster model for
# generation and this one for judging.
EVAL_JUDGE_MODEL=qwen2.5:7b-instruct

# Bounded concurrency for embedding calls during ingestion.
EMBEDDING_CONCURRENCY=4

# Server environment and authentication boundary.
APP_ENV=development
AUTH_ENABLED=true

# Empty AUTH_TOKENS_JSON uses the development-only demo tokens. Production
# deployments must configure explicit credentials/verifier configuration;
# demo tokens are disabled there. Example shape:
#   {"my-real-token": {"user_id": "alice", "tenant_id": "acme", "roles": ["OPERATOR"]}}
AUTH_TOKENS_JSON=

# Which tenant owns documents ingested through each connector
# — server-side configuration, never a value a request/ingest call can
# choose. This app has one connector instance per source_type, so this
# is a direct source_type -> tenant mapping.
FILESYSTEM_TENANT_ID=tenant-a
NOTION_TENANT_ID=tenant-a

# Explicit browser origins for the React Operations Console.
# Keep this an allow-list; never use '*' for authenticated browser traffic.
# Local frontend defaults: http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Conversation history on /chat: recent turns kept (0 disables history),
# per-turn character cap, and the standalone-query rewrite of follow-ups
# (one small LLM call; falls back to the user's question on failure).
CHAT_HISTORY_MAX_TURNS=6
CHAT_HISTORY_TURN_MAX_CHARS=2000
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_TIMEOUT_SECONDS=20

# Optional PydanticAI agent over the existing RAG tools and validators.
# Keep disabled until paired TechQA/MMLongBench evaluation justifies rollout.
AGENTIC_RAG_ENABLED=false
# Typed state-driven research graph; use only one orchestration flag.
# Reuses AGENTIC_* budgets/model settings, DERIVED_ANSWERS_ENABLED and VISUAL_ANSWERS_ENABLED.
# Source inspection, extraction, computation, and scope checks share these budgets.
ADAPTIVE_RAG_ENABLED=false
# Prepare top admitted source chunks and try answering before research.
ADAPTIVE_FAST_PATH_ENABLED=false
ADAPTIVE_EVIDENCE_NEEDS_ENABLED=false
# Reader inherits AGENTIC_REASONING. Extraction/checking is lighter;
# final interpretation/scope verification can use medium reasoning (OpenAI only).
ADAPTIVE_EXTRACTION_REASONING=low
ADAPTIVE_FINAL_REASONING=medium
# escalate: the fixed answer path runs first; the agent only handles withheld
# answers and multi-document requests. always: the agent answers every request.
AGENTIC_MODE=escalate
AGENTIC_MAX_REQUESTS=6
AGENTIC_MAX_TOOL_CALLS=8
AGENTIC_MAX_TOKENS=60000
AGENTIC_TIMEOUT_SECONDS=120
AGENTIC_OUTPUT_RETRIES=2
AGENTIC_EVIDENCE_TOKEN_BUDGET=24000
# OpenAI reasoning effort for the agent's own requests (none|low|medium|high).
# The agent only rereads answers the fixed path withheld; at "none" it repeats
# the fixed path's decision.
AGENTIC_REASONING=low

# Server-side user-submitted answer reports and operator reviews.
RESEARCH_FEEDBACK_DB_PATH=data/research-feedback.db

# Content-free agent request index for the authenticated Traces page.
REQUEST_TRACE_DB_PATH=data/request-traces.db
# Direct Jaeger links require ADMIN as well as this opt-in. Secure Jaeger
# independently; this setting is not authentication for the Jaeger service.
EXTERNAL_TRACE_LINKS_ENABLED=false
# Optional USD estimates per million tokens; use provider:model or model keys.
# No configured price / incomplete usage => Unknown, never an assumed zero.
# Example (illustrative rates only):
# MODEL_PRICING_JSON='{"openai:your-model":{"input_per_million":1,"output_per_million":4,"cached_input_per_million":0.1}}'
MODEL_PRICING_JSON={}

# Additional claim-scope verifier for agentic text/comparison candidates.
# Its actual model calls share AGENTIC_MAX_REQUESTS / TOKENS / TIMEOUT.
AGENTIC_SCOPE_VALIDATION_ENABLED=true

# Server-managed per-document user/group grants. New documents are denied
# until ADMIN grants access from Knowledge > Document permissions.
DOCUMENT_PERMISSIONS_DB_PATH=data/document-permissions.db
DOCUMENT_DEFAULT_ACCESS=restricted

# Server-owned soft research policy; SDK hard shared usage limits above still apply.
# Limits unsuccessful tool execution too; no per-request/client override.
AGENTIC_RESEARCH_POLICY={"max_research_requests":3,"max_tool_attempts":4,"max_no_progress":2,"max_validation_repairs":1,"tool_timeout_seconds":45,"model_timeout_seconds":30,"finalize_reserve_seconds":30}
