# Sprint 24: base URL of the FastAPI backend this console talks to.
# Never hardcode this in source — see src/api/client.ts.
VITE_API_BASE_URL=http://localhost:8000

# The backend allow-list is configured separately with CORS_ORIGINS.
# Local defaults: http://localhost:5173,http://127.0.0.1:5173
# The identity selector is Development identity / local demo auth only;
# it stores a demo token in localStorage and is not production auth.
