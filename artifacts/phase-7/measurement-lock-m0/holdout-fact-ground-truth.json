      "section_heading": "Standard Returns — 2026",
      "source_path": "data/evaluation/evaluation-corpus-v2/standard-returns-2026.md",
      "supporting_text_anchor": "14 calendar days",
      "supporting_text_span": "Standard-plan customers may request a refund within 14 calendar days of delivery. The item must be unused and the order reference must be available. The delivery event, rather than the date of the first support contact, starts the window."
    },
